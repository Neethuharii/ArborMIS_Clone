{% set route = app.request.attributes.get('_route') %}

<link rel="stylesheet" href="{{ asset('css/behaviour_base.css') }}">
<div class="sidebar">
    <div class="nav-container">
        <div class="nav-module-title"><b>Behaviour</b></div>
        <br>
        <hr>

        <div class="nav-items">
            <ul>
                <li>
                    <a href="{{ path('app_incident') }}" class="nav-links {{ route == 'app_incident' ? 'active' : '' }}">
                        ▶ Incidents
                    </a>
                </li>

                <li>
                    <a href="javascript:void(0)" class="nav-links" id="suspension-toggle">
                        ▶ Suspensions
                    </a>

                    <ul class="sub-links" id="suspension-menu">
                        <li>
                            <a href="{{ path('app_suspension_reporting') }}" class="sub-link {{ route == 'app_suspension_reporting'? 'active' : '' }}">
                                Reporting
                            </a>
                        </li>

                        <li>
                            <a href="{{ path('app_suspension_statistics') }} " class="sub-link {{ route == 'app_suspension_statistics'? 'active' : '' }}">
                                Statistics
                            </a>
                        </li>
                    </ul>
                </li>

                <li>
                    <a href="javascript:void(0)" class="nav-links" id="point-award-toggle">
                        ▶ Point Awards
                    </a>

                    <ul class="sub-links" id="point-award-menu">
                        <li>
                            <a href="{{ path('app_points_total') }}" class="sub-link {{ route == 'app_points_total' ? 'active' : '' }}">
                                Total Points
                            </a>
                        </li>

                        <li>
                            <a href="{{ path('app_points_recent') }}" class="sub-link {{ route == 'app_points_recent' ? 'active' : '' }}">
                                Recent Points
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    function setupToggle(toggleId, menuId) {
        const toggle = document.getElementById(toggleId);
        const menu = document.getElementById(menuId);

        if (toggle && menu) {
            toggle.addEventListener("click", function (e) {
                e.preventDefault();
                menu.classList.toggle("show");
            });
        }
    }

    setupToggle("suspension-toggle", "suspension-menu");
    setupToggle("point-award-toggle", "point-award-menu");

});
</script>