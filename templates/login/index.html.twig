{% block title %}{% endblock %}

{% block body %}
    <link rel="stylesheet" href="{{ asset('css/login.css') }}">

    <div id="page-loader" style="display:none;">
        <div class="loader-box">
            <img src="{{ asset('images/arborlogo.png') }}"  class="rotating-logo">
                <p>Loading...</p>
        </div>
    </div>

    <div id="login-form">

        <div class="login-container">
            <div class="login-card">
                <div class="logo-box">
                    <img src="{{ asset('images/arborlogo.png') }}" alt="Arbor Logo">
                </div>

                <h3 class="login-title">Welcome Back</h3>

                <p class="login-subtitle">Sign in to your Arbor MIS</p>

                {% if error is defined and error %}
                    <div class="alert">
                        {{ error }}
                    </div>
                {% endif %}

                <form method="post" onsubmit="showLoader()">

                    <div class="form-group">
                        <label for="email" class="form-label">Email Address</label>

                        <input id="email"
                           name="email"
                           type="email"
                           class="form-control"
                           required>

                        {% if emailError is defined and emailError %}
                            <span class="field-error">{{ emailError }}</span>
                        {% endif %}
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">Password</label>

                        <input id="password"
                           name="password"
                           type="password"
                           class="form-control"
                           required>

                        {% if passwordError is defined and passwordError %}
                            <span class="field-error">{{ passwordError }}</span>
                        {% endif %}
                    </div>

                    <button type="submit" class="login-btn">Login</button>

                </form>

            </div>
        </div>

    </div>

    <script>
        function showLoader() {
            document.getElementById("login-form").style.display = "none";
            document.getElementById("page-loader").style.display = "flex";
        }
    </script>

{% endblock %}
