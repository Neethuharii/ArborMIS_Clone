{% extends 'base.html.twig' %}
{% block title %}Suspension Reporting{% endblock %}
{% block body %}

<link rel="stylesheet" href="{{ asset('css/Suspension/suspension_reporting.css') }}">

<div id="page-loader" style="display: none;">
    <div class="loader-box">
        <img src="{{ asset('images/arborlogo.png') }}"  class="rotating-logo">
            <p>Loading...</p>
    </div>
</div>

<div class="page-wrapper">

    {{ include('behaviour_base.html.twig') }}
    
    <div class="main-content">
        {% for message in app.flashes('success') %}
            <div class="success-message">
                {{ message }}
            </div>
        {% endfor %}

        {% if errors is defined and errors is not empty %}
            <div class="error-box">
                {% for error in errors %}
                    <p>{{ error }}</p>
                {% endfor %}
            </div>
        {% endif %}
        <div class="suspension-reporting">
            <div>
                <h3>Suspensions</h3>
            </div>
            <div class="add-suspension-btn">
                <button class="add-btn" id="openDrawer">
                    Add Suspension
                </button>
            </div>
        </div>

        <div class="suspension-table-container">
            <table class="suspension-table">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Suspension Reason</th>
                        <th>Suspended From</th>
                        <th>Suspended Until</th>
                        <th>Days Lost</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                {% for suspension in suspensions %}
                <tr>
                    <td>{{ suspension.student }}</td>
                    <td>{{ suspension.suspensionReason }}</td>
                    <td>{{ suspension.suspendedFrom }}</td>
                    <td>{{ suspension.suspendedUntil }}</td>
                    <td>{{ suspension.daysLost }}</td>
                    <td>{{ suspension.notes }}</td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div id="drawer" class="drawer">
            <div class="drawer-header">
                <h3>Add Suspension</h3>
            </div>

            <form method="POST"
                class="suspension-form"
                id="incidentForm"
                enctype="multipart/form-data"
                action="{{ path('app_suspension_reporting') }} " onsubmit="showLoader()">

                <div class="form-group">
                    <label>Student</label>
                    <select name="student_id" required>
                        <option value="">Select Student</option>
                        {% for student in students %}
                            <option value="{{ student.studentId }}">
                                {{ student.firstName }} {{ student.lastName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label>Suspension Reason</label>
                    <select name="reason_id" required>
                        <option value="">Select Reason</option>

                        {% for reason in suspensionReasons %}
                            <option value="{{ reason.suspensionId }}">
                                {{ reason.suspensionReason }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label>Suspension From</label>
                    <input type="datetime-local"
                        name="suspended_from"
                        required>
                </div>

                <div class="form-group">
                    <label>Suspension Until</label>
                    <input type="datetime-local"
                        name="suspended_until"
                        required>
                </div>

                <div class="form-group">
                    <label>Decision Made Time</label>
                    <input type="datetime-local"
                        name="decision_made_time"
                        required>
                </div>

                <div class="form-group">
                    <label>Notes</label>
                    <textarea rows="4" name="notes"></textarea>
                </div>

                <div class="form-group">
                    <label>Supporting Document</label>

                    <div class="upload-box">
                        <input type="file"
                            name="document">
                    </div>

                </div>

                <div class="form-actions">
                    <button type="button"
                            class="cancel-btn"
                            id="cancelDrawer">
                        Cancel
                    </button>

                    <button type="submit"
                            class="save-btn">
                        Save Suspension
                    </button>
                </div>

            </form>

        </div>

        <div id="overlay" class="overlay"></div>

    </div>

</div>

<script src="{{ asset('js/suspension-reporting.js') }}"></script>

{% endblock %}