{% extends 'base.html.twig' %}
{% block title %}Suspension Reporting{% endblock %}
{% block body %}

<link rel="stylesheet" href="{{ asset('css/Suspension/suspension_reporting.css') }}">

<div class="page-wrapper">

    {{ include('Suspension/suspension_base.html.twig') }}
    
    <div class="main-content">
        <div class="suspension-reporting">
            <div>
                <h3>Suspensions</h3>
            </div>
            <div class="add-suspension-btn">
                <button class="add-btn" id="openDrawer">
                    Add Suspension
                </button>
            </div>
        </div>

        <div class="suspension-table-container">
            <table class="suspension-table">
                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Suspension Reason</th>
                        <th>Suspended From</th>
                        <th>Suspended Until</th>
                        <th>Days Lost</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>

                </tbody>
            </table>
        </div>

        <div id="drawer" class="drawer">
            <div class="drawer-header">
                <h3>Add Suspension</h3>
            </div>

            <form method="POST"
                class="suspension-form"
                enctype="multipart/form-data" 
                action="{{ path('suspension_reporting')}}">

                <div class="form-group">
                    <label>Student</label>
                    <select name="student_id" required>
                        <option value="">Select Student</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Suspension Reason</label>
                    <select name="reason_id" required>
                        <option value="">Select Reason</option>

                        {% for reason in suspensionReasons %}
                            <option value="{{ reason.suspensionId }}">
                                {{ reason.suspensionReason }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label>Suspension From</label>
                    <input type="datetime-local"
                        name="suspended_from"
                        required>
                </div>

                <div class="form-group">
                    <label>Suspension Until</label>
                    <input type="datetime-local"
                        name="suspended_until"
                        required>
                </div>

                <div class="form-group">
                    <label>Decision Made Time</label>
                    <input type="datetime-local"
                        name="decision_made_time"
                        required>
                </div>

                <div class="form-group">
                    <label>Notes</label>
                    <textarea rows="4" name="notes"></textarea>
                </div>

                <div class="form-group">
                    <label>Supporting Document</label>

                    <div class="upload-box">
                        <input type="file"
                            name="document">
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button"
                            class="cancel-btn"
                            id="cancelDrawer">
                        Cancel
                    </button>

                    <button type="submit"
                            class="save-btn">
                        Save Suspension
                    </button>
                </div>

            </form>

        </div>

        <div id="overlay" class="overlay"></div>

    </div>

</div>

<script src="{{ asset('js/suspension_reporting.js') }}"></script>

{% endblock %}