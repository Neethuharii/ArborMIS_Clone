{% extends 'base.html.twig' %}

{% block title %}Teacher Profile{% endblock %}

{% block stylesheets %}
{{parent()}}
<link rel="stylesheet" href="{{asset('css/Staff/profile.css')}}">
{% endblock %}

{% block body %}
<div class="profile-container">

    <div class="profile-header">
        <div class="profile-image">
            <img src="{{asset('images/dummy-profile.png')}}">
        </div>

        <div class="profile-info">
            <h1>{{ staff.title.titleName }} {{ staff.firstName }} {{ staff.lastName }}</h1>

            <table class="summary-table">
                <tr>
                    <td class="label">Role</td>
                    <td><strong>{{staff.currentRole.businessRole.nameOfRole}}</strong></td>
                </tr>
                <tr>
                    <td class="label">Joined</td>
                    <td><strong>{{staff.createdAt|date('d F')}}</strong></td>
                </tr>
            </table>
        </div>
    </div>

    <div class="section-card">
        <div class="section-header">
            <h2>Identity</h2>
        </div>

        <table class="details-table">
            <tbody>
            {#<tr>
                <th>Name</th>
                <td>{{ staff.title.titleName }} {{ staff.firstName }} {{ staff.lastName }}</td>
                <td class="arrow">▶</td>
            </tr>#}

            <tr class="clickable-row" 
                data-title="Name" 
                data-type="identity"
                data-title-name="{{ staff.title.titleName }}"
                data-first-name="{{ staff.firstName }}"
                data-middle-name="{{ staff.middleName }}"
                data-last-name="{{ staff.lastName }}">
                <th>Name</th>
                <td>{{ staff.title.titleName }} {{ staff.firstName }} {{ staff.lastName }}</td>
                <td class="arrow">▶</td>
            </tr>

            <tr class="clickable-row" 
                data-title="Sex" 
                data-type="sex"
                data-gender-type="{{ staff.gender.genderType }}">
                <th>Sex</th>
                <td>{{ staff.gender.genderType }}</td>
                <td class="arrow">▶</td>
            </tr>

            <tr class="clickable-row" 
                data-title="Date of birth" 
                data-type="dob"
                data-dob="{{ staff.dateOfBirth|date('d/m/Y') }}">
                <th>Date of birth</th>
                <td>{{ staff.dateOfBirth|date('d/m/Y') }}</td>
                <td class="arrow">▶</td>
            </tr>

            <tr>
                <th>Ethnicity</th>
                <td>Not recorded</td>
                <td class="arrow">▶</td>
            </tr>

            <tr>
                <th>Teacher Number</th>
                <td>Not recorded</td>
                <td class="arrow">▶</td>
            </tr>

            <tr>
                <th>Religion</th>
                <td>Not recorded</td>
                <td class="arrow">▶</td>
            </tr>

            <tr>
                <th>Arbor Staff ID</th>
                <td>Not recorded</td>
                <td class="arrow">▶</td>
            </tr>

            <tr>
                <th>Staff Number</th>
                <td>Not recorded</td>
                <td class="arrow">▶</td>
            </tr>

            <tr>
                <th>School ID Card</th>
                <td>Not issued</td>
                <td class="arrow">▶</td>
            </tr>

            <tr>
                <th>Abbreviation</th>
                <td>{{ staff.abbreviation }}</td>
                <td class="arrow">▶</td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="section-card">
        <div class="section-header">
            <h2>Staff Contact Details</h2>
        </div>

        <table class="details-table">
            <tbody>
            <tr>
                <th>Work Email</th>
                <td>{{ staff.address.emailAddress }}</td>
                <td class="arrow">▶</td>
            </tr>

            <tr>
                <th>Staff Home Number</th>
                <td>{{ staff.address.phoneNumber }}</td>
                <td class="arrow">▶</td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="section-card">
            <div class="section-header">
                <h2>Current Business Roles</h2>
            </div>

            <table class="details-table">
                <tbody>
                <tr>
                    <th>{{staff.currentRole.businessRole.nameOfRole}}</th>
                    <td>{{ staff.currentRole.startDate|date('d M Y') }} - Ongoing </td>
                    <td class="arrow">▶</td>
                </tr>
                </tbody>
            </table>
        </div>

    <div class="section-card">
            <div class="section-header">
                <h2>Qualifications & Checks </h2>
            </div>

            <table class="details-table">
                <tbody>
                <tr>
                    <th>Academic Qualifications</th>
                    <td>No clearance level set</td>
                    <td class="arrow">▶</td>
                </tr>
                </tbody>
            </table>
    </div>

    <div id="slideoverContainer" class="slideover-container">
        <div id="slideoverOverlay" class="slideover-overlay"></div>
            <div class="slideover-drawer">
                <div class="slideover-header">
                    <button id="closeBtn"><< Back</button>
                    <h3 id="slideTitle">Details</h3>
                    <button id="nextBtn">Edit</button>
                </div>
                <hr>
                <div class="slideover-body">
                    <div id="slideDynamicContent"></div>
                </div>
            </div>
    </div>

{% block javascripts %}
    <script src="{{asset('js/slide.js')}}"></script>
{% endblock %}

{% endblock %}
