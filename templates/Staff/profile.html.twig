{% extends 'base.html.twig' %}

{% block title %}Teacher Profile{% endblock %}

{% block stylesheets %}
    {{parent()}}
    <link rel="stylesheet" href="{{asset('css/Staff/profile.css')}}">
    <link rel="stylesheet" href="{{asset('css/Slideover/slideover.css')}}">
{% endblock %}

{% block body %}
    {{ include('_modalbase.html.twig', {
        'qualification_types': qualification_types,'entity': entity,'all_staffs': all_staffs|default([])}) 
    }}
    
    <div class="profile-container">
    <form method="post" action="{{ path('profile_picture', {id: staff.staffId}) }}" enctype="multipart/form-data">    
        <div class="profile-header">
            <div class="profile-image">
            <label for="profileImage">
               <img src="{{ staff.profilePhoto ? asset('uploads/profile/' ~ staff.profilePhoto) : asset('images/defaultProfile.png') }}" alt="Profile Image" style="cursor:pointer;">
            </label>
            <input type="file" id="profileImage" name="profile" accept="image/*" style="display:none;" onchange="this.form.submit();">
            </div>

            <div class="profile-info">
                <h1>{{ staff.title.titleName }} {{ staff.firstName }} {{ staff.lastName }}</h1>

                <table class="summary-table">
                    <tr>
                        <td class="label">Role</td>
                        <td>
                            <strong>
                                {% if staff.currentRole and staff.currentRole.businessRole %}
                                    {{ staff.currentRole.businessRole.nameOfRole }}
                                {% else %}
                                    No Active Role
                                {% endif %}
                            </strong>
                        </td>                    
                    </tr>
                        <td class="label">Joined</td>
                        <td><strong>{{staff.createdAt|date('d F')}}</strong></td>
                    </tr>
                </table>
            </div>
        </div>
    </form>
        <div class="section-card">
            <div class="section-header">
                <h2>Identity</h2>
                <div id="identityAdd" style="cursor: pointer;">
                    <p>✚ Add</p>
                </div>
            </div>
            
            <table class="details-table">
                <tbody>
                    <tr class="clickable-row" 
                        data-title="Name" 
                        data-type="identity"
                        data-title-name="{{ staff.title.titleName }}"
                        data-first-name="{{ staff.firstName }}"
                        data-middle-name="{{ staff.middleName }}"
                        data-last-name="{{ staff.lastName }}">
                        <th>Name</th>
                        <td>{{ staff.title.titleName }} {{ staff.firstName }} {{ staff.lastName }}</td>
                        <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row" 
                        data-title="Gender" 
                        data-type="sex"
                        data-gender-type="{{ staff.gender.genderType }}">
                        <th>Gender</th>
                        <td>{{ staff.gender.genderType }}</td>
                        <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row" 
                        data-title="Date of birth" 
                        data-type="dob"
                        data-dob="{{ staff.dateOfBirth|date('d/m/Y') }}">
                        <th>Date of birth</th>
                        <td>{{ staff.dateOfBirth|date('d/m/Y') }}</td>
                        <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row" 
                        data-title="Ethnicity" 
                        data-type="ethnicity"
                        data-ethnicity="{{ staff.ethnicity.ethnicityName|default('Not recorded') }} ">
                        <th>Ethnicity</th>
                        <td>{{ staff.ethnicity ? staff.ethnicity.ethnicityName : 'Not recorded' }}</td>
                        <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row" 
                        data-title="Nationality" 
                        data-type="nationality"
                        data-nationality="{{ staff.nationality ? staff.nationality.nationalityStatus : 'Not recorded' }}"
                        data-country="{{ staff.country ? staff.country.countryName : 'Not recorded' }}">
                        <th>Nationality</th>
                        <td>{{ staff.country ? staff.country.countryName : 'Not recorded' }} ({{ staff.nationality ? staff.nationality.nationalityStatus : 'Not recorded' }})</td>
                        <td class="arrow">▶</td>
                    </tr>


                    <tr class="clickable-row" 
                        data-title="Religion" 
                        data-type="religion"
                        data-religion="{{ staff.Religion.religionName|default('Not recorded') }}">
                        <th>Religion</th>
                        <td>{{ staff.Religion.religionName|default('Not recorded') }}</td>
                        <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row" 
                        data-title="Staff Number" 
                        data-type="staffNumber"
                        data-staffNumber="{{ staff.staffNumber|default('Not recorded') }} ">
                        <th>Staff Number</th>
                        <td>{{ staff.staffId|default('Not recorded') }}</td>
                        <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row" 
                        data-title="School ID Card" 
                        data-type="idcard"
                        data-idcard="{{ staff.idcard ? staff.idcard.cardNumber : 'Not issued' }}"
                        data-issueddate="{{ (staff.idcard and staff.idcard.getIssuedAt()) ? staff.idcard.getIssuedAt()|date('Y-m-d') : '' }}"
                        data-issuedtime="{{ (staff.idcard and staff.idcard.getIssuedAt()) ? staff.idcard.getIssuedAt()|date('H:i') : '' }}">
                        <th>School ID Card</th>
                        <td>{{ staff.idcard ? staff.idcard.cardNumber : 'Not issued' }}</td>
                        <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row" 
                        data-title="Abbreviation" 
                        data-type="abbreviation"
                        data-abbreviation="{{ staff.abbreviation|default('Not recorded') }} ">
                        <th>Abbreviation</th>
                        <td>{{ staff.abbreviation|default('Not recorded') }}</td>
                        <td class="arrow">▶</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="section-card">
            <div class="section-header">
                <h2>Staff Contact Details</h2>
                    <div id="contactAdd" style="cursor: pointer;">
                            <p>✚ Add</p>
                    </div>
            </div>

            <table class="details-table">
                <tbody>
                    <tr class="clickable-row" 
                            data-title="Email" 
                            data-type="email"
                            data-email="{{ staff.address.emailAddress }}">
                            <th>Work Email</th>
                            <td>{{ staff.address.emailAddress }}</td>
                            <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row"
                        data-title="Staff Home Number"
                        data-type="phoneNumber"
                        data-phone-number= "{{ staff.address ? staff.address.phoneNumber : 'Not recorded' }}">
                            <th>Staff Home Number</th>
                            <td>{{ staff.address ? staff.address.phoneNumber : 'Not recorded' }}</td>
                            <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row"
                        data-title="Address"
                        data-type="address"
                        data-address1= "{{ staff.address ? staff.address.address1 : 'Not recorded' }}"
                        data-address2= "{{ staff.address ? staff.address.address2 : 'Not recorded' }}"
                        data-address3= "{{ staff.address ? staff.address.address3 : 'Not recorded' }}"
                        data-city= "{{ staff.address ? staff.address.city : 'Not recorded' }}"
                        data-county= "{{ staff.address ? staff.address.county : 'Not recorded' }}"
                        data-post-code= "{{ staff.address ? staff.address.postCode : 'Not recorded' }}">
                        <th>Postal Address</th>
                        <td>{{ staff.address ?staff.address.address1 : 'Not recorded' }} 
                            {{ staff.address ?staff.address.address2 : 'Not recorded' }} 
                            {{ staff.address ?staff.address.address3 : 'Not recorded' }}
                            {{ staff.address ?staff.address.city : 'Not recorded' }}
                            {{ staff.address ?staff.address.county : 'Not recorded' }}
                            {{ staff.address ?staff.address.postCode : 'Not recorded' }}
                        </td>
                        <td class="arrow">▶</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="section-card">
            <div class="section-header">
                <h2>Current Business Roles</h2>
                    <div id="businessAdd" class="open-slideover" data-type="role" style="cursor: pointer;">
                        <p>✚ Add</p>
                    </div>
            </div>

            <table class="details-table">
               <tbody>
                    {% for role in allRoles %}
                        <tr class="clickable-row"
                            data-type="currentRole"
                            data-title="Current Business Roles"
                            data-current-role="{{ role.businessRole.nameOfRole }}"
                            data-start-date="{{ role.startDate|date('d M Y') }}">
                            <th>{{ role.businessRole.nameOfRole }}</th>
                            <td>
                                {{ role.startDate|date('d M Y') }} - 
                                {{ role.endDate ? role.endDate|date('d M Y') : 'Ongoing' }}
                            </td>
                            <td class="arrow">▶</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3">No historical roles found for this staff member.</td>
                        </tr>
                    {% endfor %}
            </tbody>
            </table>
        </div>

        <div class="section-card">
                <div class="section-header">
                    <h2>Qualifications & Checks </h2>
                    <div id="qualificationAdd" data-type="qualification" style="cursor: pointer;">
                        <p>✚ Add</p>
                    </div>
                </div>

                <table class="details-table">
                    <tbody>
                        {% for checks in allQualifications %}
                        <tr class="clickable-row"
                            data-type="check"
                            data-title="Check"
                            data-qualification-name="{{ checks.qualificationType.qualificationName }}"
                            data-clearance-level = "{{ checks.clearanceLevel }}"
                            data-requested-date = "{{ checks.requestedDate|date('d M Y') }}"
                            data-returned-date = "{{ checks.returnedDate|date('d M Y') }}"
                            data-authenticated-date = "{{ checks.authenticatedDate|date('d M Y') }}"
                            data-authenticated-by = "{% if checks.authenticatedBy is not null %}{{checks.authenticatedBy.firstName}}{{checks.authenticatedBy.lastName}}{% else %}N/A{% endif %}""
                            data-comment = "{{ checks.comment }}"
                            >
                            <th>{{ checks.qualificationType.qualificationName }}</th>
                            <td>{{ checks.clearanceLevel }} </td>
                            <td class="arrow">▶</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
        </div>

        <div id="slideoverContainer" class="slideover-container">
            <div id="slideoverOverlay" class="slideover-overlay"></div>
                <div class="slideover-drawer">
                    <div class="slideover-header">
                        <button id="closeBtn">❮❮ Back</button>
                        <h2 id="slideTitle" style="font-size: 14px; margin: 7px; font-family: sans-serif;"></h2>
                        <button id="nextBtn" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center; text-align: center;">Edit</button>
                    </div>
                    <div class="slideover-body">
                        <div id="slideDynamicContent"></div>
                    </div>
                </div>
            </div>
        </div>

        <template id="nameEditTemplate">

            <div class="edit-form-wrapper">

                <h2>Name</h2>

                <form id="editIdentityForm">

                    <input type="hidden" name="staffId" value="{{ staff.staffId }}" >

                    <div class="form-row">
                        <label>Legal first name</label>
                        <input type="text" name="firstName" value="{{ staff.firstName }}">
                    </div>

                    <div class="form-row">
                        <label>Preferred first name</label>
                        <input type="text" name="preferredFirstName" value="{{ staff.firstName }}">
                    </div>

                    <div class="form-row">
                        <label>Legal middle names</label>
                        <input type="text" name="middleName" value="{{ staff.middleName }}">
                    </div>

                    <div class="form-row">
                        <label>Legal last name</label>
                        <input type="text" name="lastName" value="{{ staff.lastName }}">
                    </div>

                    <div class="form-row">
                        <label>Preferred last name</label>
                        <input type="text" name="preferredLastName" value="{{ staff.lastName }}">
                    </div>

                    <div class="button-group">
                        <button type="button" class="cancel-btn" id="cancelEdit"> Cancel </button>
                        <button type="submit" class="save-btn"> Save Changes </button>
                    </div>

                </form>
        </template>

        <template id="genderEditTemplate">

            <div class="edit-form-wrapper">

                <form id="editGenderForm">

                    <input type="hidden" name="staffId" value="{{ staff.staffId }}" >
                    <div class="form-row">
                        <label for="gender">Gender <span class="required"> </label>
                        <select id="gender" name="gender" class="template-select">
                            <option value="">Select Sex</option>
                            {% for gender in all_genders %}
                                <option value="{{ gender.genderId }}">{{ gender.genderType }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="button-group">
                        <button type="button" class="cancel-btn" id="cancelEdit"> Cancel </button>
                        <button type="submit" class="save-btn">Save Changes</button>
                    </div>
                </form>
            </div>
        </template>

        <template id="dobEditTemplate">

            <div class="edit-form-wrapper">

                <h2>Date of Birth</h2>

                <form id="editDobForm">

                    <input type="hidden" name="staffId" value="{{ staff.staffId }}" >

                    <div class="form-row">
                        <label>DOB</label>
                        <input type="Date" name="dob" value="{{ staff.dateOfBirth|date('d m') }}" >
                    </div>

                    <div class="button-group">
                        <button type="button" class="cancel-btn" id="cancelEdit" > Cancel </button>
                        <button type="submit" class="save-btn" > Save Changes </button>
                    </div>
                </form>
            </div>
        </template>

        <template id="ethnicityEditTemplate">

            <div class="edit-form-wrapper">

                <h2>Ethnicity</h2>

                <form id="editEthnicityForm">

                    <input type="hidden" name="staffId" value="{{ staff.staffId }}" >

                    <div class="form-row">
                        <label>Ethnicity <span class="required">*</span></label>
                        <select id="ethnicity" name="ethnicity" class="template-select">

                            <option value="">Select Ethnicity</option>
                            {% for ethnicity in all_ethnicities %}
                                <option value="{{ ethnicity.ethnicityId }}">{{ ethnicity.ethnicityName }}</option>
                            {% endfor %}
                        </select>

                    </div>

                    <div class="button-group">
                        <button type="button" class="cancel-btn" id="cancelEdit" > Cancel </button>
                        <button type="submit" class="save-btn" > Save Changes </button>
                    </div>
                </form>
            </div>
        </template>

        <template id="nationalityEditTemplate">

            <div class="edit-form-wrapper">

                <form id="editNationalityForm" action="{{ path('staff_update', {'id': staff.staffId}) }}">

                <input type="hidden" name="staffId" value="{{ staff.staffId }}" >

                <div class="form-row">
                    <label>Country</label>
                    <select id="country" name="country" class="template-select">
                        <option value="">Select Country</option>
                        {% for country in countries %}
                            <option value="{{ country.countryId }}"
                                {% if staff.country and staff.country.countryId == country.countryId %}selected{% endif %}>
                                {{ country.countryName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                    <div class="form-row">    
                        <label>Nationality</label>
                        <select id="nationality" name="nationality" class="template-select">
                            {% for status in all_nationalities %}
                                <option value="{{ status.nationalityId }}"
                                    {% if staff.nationality and staff.nationality.nationalityId == status.nationalityId %}selected{% endif %}> {{ status.nationalityStatus }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="button-group">
                        <button type="button" class="cancel-btn">Cancel</button>
                        <button type="submit" class="save-btn">Save Changes</button>
                    </div>

                </form>
            </div>
        </template>

        <template id="religionEditTemplate">

            <div class="edit-form-wrapper">

                <h2>Religion</h2>

                <form id="editReligionForm">

                    <input type="hidden" name="staffId" value="{{ staff.staffId }}" >

                    <div class="form-row">
                        <label>Religion</label>
                        <select id="religion" name="religion" class="template-select">

                            <option value="">Select Religion</option>
                            {% for religion in all_religions %}
                                <option value="{{ religion.religionId }}">{{ religion.religionName }}</option>
                            {% endfor %}
                        </select>

                    </div>

                    <div class="button-group">
                        <button type="button" class="cancel-btn" id="cancelEdit" > Cancel </button>
                        <button type="submit" class="save-btn" > Save Changes </button>
                    </div>
                </form>
            </div>
        </template>

        <template id="abbreviationEditTemplate">

            <div class="edit-form-wrapper">

                <h2>Abbreviation</h2>

                <form id="editAbbreviationForm">

                    <input type="hidden" name="staffId" value="{{ staff.staffId }}" >

                    <div class="form-row">
                        <label>Abbreviation</label>
                        <input type="text" name="abbreviation" value="{{ staff.abbreviation }}">
                    </div>

                    <div class="button-group">
                        <button type="button" class="cancel-btn" id="cancelEdit" > Cancel </button>
                        <button type="submit" class="save-btn" > Save Changes </button>
                    </div>
                </form>
            </div>
        </template>

        <template id="identificationTemplate">
            {% include 'Slideover/identificationDocument.html.twig'%}
        </template>
        
        <template id="studentCardTemplate">
            {% include 'Slideover/studentIdCard.html.twig'%}
        </template>

        <template id="postalAddressTemplate">
            {% include 'Slideover/postalAddress.html.twig' %}
        </template>

        <template id="emailEditTemplate">
            <div class="edit-form-wrapper">
                <h2>Email</h2>
                <form id="editEmailForm">
                    
                    <input type="hidden" name="staffId" value="{{ staff.staffId }}">

                    <div class="form-row">
                        <label>Email</label>
                        <input type="email" name="email" value="{{ staff.address ? staff.address.emailAddress : '' }}">
                    </div>

                    <div class="button-group">
                        <button type="button" class="cancel-btn" id="cancelEdit"> Cancel </button>
                        <button type="submit" class="save-btn"> Save Changes </button>
                    </div>
                </form>
            </div>
        </template>

        <template id="roleAddTemplate">
            {% include 'Slideover/businessRole.html.twig' %}
        </template>

        <template id="qualificationCheckTemplate">
            {% include 'Slideover/qualificationChecks.html.twig' %}  
        </template>
        
        {% block javascripts %}
            <script src="{{ asset('js/formHandler.js') }}"></script>
            <script src="{{ asset('js/slide.js') }}"></script>
            <script src="{{ asset('js/modal.js') }}"></script>
        {% endblock %}
{% endblock %}
