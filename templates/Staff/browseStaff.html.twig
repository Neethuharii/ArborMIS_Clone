{% extends 'base.html.twig' %}

{% block title %}Staff List{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{asset('css/Staff/browseStaff.css')}}"
{% endblock %}

{% block body %}

    <h2>Staff Members</h2>
    <div class="staff-container">

        {% for staff in staffs %}
            <a href="{{ path('staffProfile', {id: staff.staffId}) }}" class="staff-link">
                <div class="staff-card">

                    <div class="staff-photo">
                          <img
                  src="{{ staff.profilePhoto 
                  ? asset('uploads/profile/' ~ staff.profilePhoto) 
                  : asset('images/defaultProfile.png') }}"
                  alt="Profile Image"
                  style="cursor:pointer;"
                >
                    </div>

                    <div class="staff-info">
                        <h3>
                            {{ staff.title.titleName }}
                            {{ staff.firstName }}
                            {{ staff.lastName }}
                        </h3>

                        <div class="staff-role">
                        <hr>
                            Roles: 
                            {% if staff.currentRole and staff.currentRole.businessRole %}
                                {{ staff.currentRole.businessRole.nameOfRole }}
                            {% else %}
                                <span class="text-muted">No Role Assigned</span>
                            {% endif %}                        
                        <hr>
                        </div>
                        
                        <div class="staff-meta">
                            <div>Staff ID: {{ staff.staffId }}</div>
                            <div>Email: {{ staff.address.emailAddress }}</div>
                        </div>
                    </div>
                </div>
            </a>
        {% endfor %}
</div>

{% endblock %}
