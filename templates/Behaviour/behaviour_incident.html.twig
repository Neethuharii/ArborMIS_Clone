{% extends 'base.html.twig' %}
{% block title %} Behaviour Incidents {% endblock %}
{% block body %}

<link rel="stylesheet" href="{{ asset('css/Behaviour/behaviour_incident.css') }}">

<div id="page-loader" style="display: none;">
    <div class="loader-box">
        <img src="{{ asset('images/arborlogo.png') }}"  class="rotating-logo">
            <p>Loading...</p>
    </div>
</div>

<div class="page-wrapper">

    {{ include('behaviour_base.html.twig') }}

    <div class="main-content">
        {% for message in app.flashes('success') %}
            <div class="success-message">
                {{ message }}
            </div>
        {% endfor %}

        {% if errors is defined and errors is not empty %}
            <div class="error-box">
                {% for error in errors %}
                    <p>{{ error }}</p>
                {% endfor %}
            </div>
        {% endif %}

        <div class="incident-reporting">
            <h3>Behavioural Incidents</h3>
            <div class="add-incident-btn">
                <button class="add-btn" id="openDrawer">
                    Log Incident
                </button>
            </div>
        </div>

        <div class="search-row">
            {{ include('search_bar.html.twig', {
                inputId: 'incident-search',
                placeholder: 'Search student...'
            }) }}
        </div>

        <div class="incident-table-container">
            <table class="incident-table">
                <thead>
                    <tr>
                        <th>Date/Time</th>
                        <th>Severity</th>
                        <th>Behaviour</th>
                        <th>Students Involved</th>
                    </tr>
                </thead>
                <tbody>
                    {% for incident in incidents %}
                        <tr>
                            <td>
                                {{ incident.incidentDate|date('Y-m-d') }} {{ incident.incidentTime|date('H:i') }}
                            </td>
                            <td>
                                {{ incident.behaviour.category.categoryName }}
                            </td>
                            <td>
                                {{ incident.behaviour.behaviourName }}
                            </td>
                            <td>
                                {% for student in incident.studentInvolved %}
                                    {{ student.firstName }} {{ student.lastName }}
                                    {% if not loop.last %} and {% endif %}
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div id="drawer" class="drawer">
            <div class="drawer-header">
                <h3>Log Incident</h3>
            </div>

            <form method="POST"
                class="incident-form"
                id="incidentForm"
                action="{{ path('app_incident') }}"
                >

                <div class="form-group">
                    <label>Date of Incident</label>
                    <input type="date" name="incident_date" required>
                </div>

                <div class="form-group">
                    <label>Time of Incident</label>
                    <input type="time" name="incident_time" required>
                </div>

                <div class="form-group">
                    <label>Students Involved</label>
                    <select name="students[]" multiple required>
                        {% for student in students %}
                            <option value="{{ student.studentId }}">
                                {{ student.firstName }} {{ student.lastName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label>Behaviour</label>
                    <select name="behaviour_id" required>
                        {% for behaviour in behaviours %}
                            <option value="{{ behaviour.behaviourId}}">
                                {{ behaviour.behaviourName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label>Assign to Staff Member</label>
                    <select name="assigned_staff" required>
                        {% for staff in staffs %}
                            <option value="{{ staff.staffId }}">
                                {{ staff.firstName }} {{ staff.lastName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label>Incident Summary</label>
                    <textarea rows="4" name="incident_summary"></textarea>
                </div>

                <div class="form-group">
                    <label>Staff Involved</label>
                    <select name="staff_involved[]" multiple>
                        {% for staff in staffs %}
                            <option value="{{ staff.staffId }}">
                                {{ staff.firstName }} {{ staff.lastName }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" name="create_separate" id="createSeparate">
                    <label for="createSeparate">Create as separate incidents</label>
                </div>

                <div class="intervention-section">
                    <div class="section-header">
                        <h4>Physical Intervention</h4>
                        <button type="button" class="mini-add-btn" id="addInterventionRow">
                            + Add Detail
                        </button>
                    </div>

                    <div class="intervention-table-container">
                        <table class="intervention-table">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Staff Member</th>
                                    <th>Method Used</th>
                                </tr>
                            </thead>
                            <tbody id="interventionBody">
                                
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="button" class="cancel-btn" id="cancelDrawer">
                        Cancel
                    </button>

                    <button type="submit" class="save-btn">
                        Submit
                    </button>
                </div>
            </form>
        </div>

        <div id="overlay" class="overlay"></div>

    </div>

</div>
<script>
    const studentsData = [
        {% for student in students %}
        {
            studentId: {{ student.studentId }},
            firstName: "{{ student.firstName|e('js') }}",
            lastName: "{{ student.lastName|e('js') }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const staffsData = [
        {% for staff in staffs %}
        {
            staffId: {{ staff.staffId }},
            firstName: "{{ staff.firstName|e('js') }}",
            lastName: "{{ staff.lastName|e('js') }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    const interventionMethodsData = [
        {% for method in interventionMethods %}
        {
            interventionId: {{ method.interventionId }},
            interventionMethod: "{{ method.interventionMethod|e('js') }}"
        }{% if not loop.last %},{% endif %}
        {% endfor %}
    ];
</script>

<script src="{{ asset('js/incident-reporting.js') }}"></script>
<script src="{{ asset('js/search.js') }}"></script>

{% endblock %}