{% block body %}

<div id="identityModal" class="modal">
    <div class="modal-content">

        <div class="modal-header">
            <h2>What would you like to do?</h2>
            <span class="close">&times;</span>
        </div>

        <div class="modal-body">
            <div class="section-title-box">
                <h3>Add Item in: Identity</h3>
            </div>

            <ul class="item-list">
                <li class="open-slideover" data-type="identification">
                    Identification Document ▶
                </li>

                <li class="open-slideover" data-type="schoolIdCard">
                    School Id Card ▶
                </li>
            </ul>
        </div>

        <div class="modal-footer">
            <button class="cancel-btn"
                onclick="document.getElementById('identityModal').style.display='none'">
                Cancel
            </button>
        </div>

    </div>
</div>

<div id="contactModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>What would you like to do?</h2>
            <span class="contactClose">&times;</span>
        </div>

        <div class="modal-body">
            <div class="section-title-box">
                <h3>Add Item in: Staff Contact Details</h3>
            </div>
            <ul class="item-list">
                <li class="open-slideover" data-type="postalAddress">Postal address ▶</li>
            </ul>
        </div>

        <div class="modal-footer">
            <button class="cancel-btn" onclick="document.getElementById('contactModal').style.display='none'">Cancel</button>
        </div>
            </div>
        </div>
</div>

<div id="qualificationModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>What would you like to do?</h2>
            <span class="qualificationClose">&times;</span>
        </div>

        <div class="modal-body">
            <div class="section-title-box">
                <h3>Add Item in: Qualifications & Checks </h3>
            </div>
           <ul class="item-list">
                {% if qualification_types is defined and qualification_types is not empty %}
                    {% for type in qualification_types %}
                        <li class="open-slideover" data-type="qualification"  data-id="{{ type.qualificationId }}" data-name="{{ type.qualificationName }}">{{ type.qualificationName }} ▶
                        </li>
                    {% endfor %}
                {% else %}
            <li>No qualifications available</li>
    {% endif %}
</ul>
        </div>

        <div class="modal-footer">
            <button class="cancel-btn" onclick="document.getElementById('qualificationModal').style.display='none'">Cancel</button>
        </div>
        </div>
    </div>
</div>

<div id="slideoverContainer" class="slideover-container">
    <div id="slideoverOverlay" class="slideover-overlay"></div>

    <div class="slideover-drawer">

        <div class="slideover-header">
            <button id="closeBtn">← Back</button>

            <h3 id="slideTitle">Details</h3>

            <button id="nextBtn">Edit</button>
        </div>

        <hr>

        <div class="slideover-body">
            <div id="slideDynamicContent"></div>
        </div>

    </div>
</div>
{% block javascripts %}
    <script src="{{asset('js/modal.js')}}"></script>
{% endblock %}

{% endblock %}
