
{% block body %}
<div class="page-container guardian-form-container">

    <h1 class="page-title">Add New Guardian</h1>

    <form method="POST" action="{{ path('guardian_add', {studentId: student.studentId}) }}" class="guardian-form">

        <div class="card">
            <div class="card-header">
                <h2>Guardian Details</h2>
            </div>

            <div class="card-body">
                <div class="form-row">
                    <label>Linked to Student</label>
                    <div class="readonly-field">
                        {{ student.firstName }} {{ student.lastName }}
                    </div>
                </div>

                <div class="form-row">
                    <label for="title">Title *</label>
                    <select id="title" name="title">
                        <option value="">Select Title</option>
                        {% for title in titles %}
                            <option value="{{ title.titleId }}">{{ title.titleName }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-row">
                    <label for="firstName">First name *</label>
                    <input type="text" id="firstName" name="firstName" required>
                </div>

                <div class="form-row">
                    <label for="lastName">Last name *</label>
                    <input type="text" id="lastName" name="lastName" required>
                </div>

                <div class="form-row">
                    <label for="sex">Sex *</label>
                    <select id="sex" name="sex">
                        <option value="">Select sex</option>
                        {% for gender in genders %}
                            <option value="{{ gender.genderId }}">{{ gender.genderType }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-row">
                    <label for="relationship">Relationship *</label>
                    <select id="relationship" name="relationship" required>
                        <option value="">Select relationship</option>
                        {% for relationship in relationships %}
                            <option value="{{ relationship.relationshipTypeId }}">{{ relationship.relationshipTypeName }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-row checkbox-group">
                    <label>
                        <input type="checkbox" name="primaryGuardian"> Primary guardian
                    </label>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h2>Contact Details</h2>
            </div>

            <div class="card-body">
                <div class="form-row">
                    <label for="mobileNumber">Mobile number</label>
                    <input type="text" id="mobileNumber" name="mobileNumber">
                </div>

                <div class="form-row">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email">
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary" style="  background: rgb(12, 112, 12);color: white;padding: 10px; 
                margin: 10px 0; 
                border-radius: 5px;">Add Guardian
            </button>
        </div>

    </form>
</div>
{% endblock %}
