
{% block title %}{% endblock %}

{% block body %}
   
<form id="identificationForm"
      class="identification-form"
      method="POST"
      action=""> {# Add path #}

    <input type="hidden" name="studentId" value="{{ student.studentId }}">

    <h2 class="form-title">Add Identification Document</h2>

    <div class="form-container">

        <div class="form-row">
            <label>Type *</label>
            <select name="documentType" required>
                <option value="">Select document type</option>
                {% for documentType in documentTypes %}
                    <option value="{{ documentType.documentTypeId }}">
                        {{ documentType.documentTypeName }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="form-row">
            <label>Document number *</label>
            <input type="text" name="documentNumber" required>
        </div>

        <div class="form-row">
            <label>Issue date</label>
            <input type="date" name="issueDate">
        </div>

        <div class="form-row">
            <label>Expiry date</label>
            <input type="date" name="expiryDate">
        </div>

        <div class="form-row">
            <label>Name on document *</label>
            <input type="text" name="documentName"
                   value="{{ student.firstName }} {{ student.lastName }}">
        </div>

        <div class="form-row">
            <label>Issuing country</label>
            <select name="issuingCountry">
                <option value="">Select country</option>
                {% for country in countries %}
                    <option value="{{ country.countryId }}">
                        {{ country.countryName }}
                    </option>
                {% endfor %}
            </select>
        </div>

    </div>

    <div class="button-group">
        <button type="button" class="cancel-btn">Cancel</button>
        <button type="submit" class="save-btn">Add document</button>
    </div>

</form>
{% endblock %}
