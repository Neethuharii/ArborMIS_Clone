{% block body %}

<div class="identification-wrapper">
    <form id="identificationForm" class="identification-form" method="POST">
        <input type="hidden" name="entityId" value="{{ entityId }}">
        <input type="hidden" name="entityType" value="{{ entityType }}">
        <h2 class="form-title">Add Identification Document</h2>
        <div class="form-container">
            <div class="form-row">
                <label>
                    Type <span class="required">*</span>
                </label>
                <select name="documentType" required>
                    <option value="">Select document type</option>
                    {% for documentType in documentTypes %}
                        <option value="{{ documentType.documentTypeId }}">
                            {{ documentType.documentTypeName }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-row">
                <label>
                    Document Number <span class="required">*</span>
                </label>
                <input
                    type="text"
                    name="documentNumber"
                    required
                >
            </div>
            <div class="form-row">
                <label>Issue Date</label>
                <input
                    type="date"
                    name="issueDate"
                >
            </div>
            <div class="form-row">
                <label>Expiry Date</label>
                <input
                    type="date"
                    name="expiryDate"
                >
            </div>
            <div class="form-row">
                <label>
                    Name on Document <span class="required">*</span>
                </label>
                <input
                    type="text"
                    name="documentName"
                    value="{{ entity.firstName ?? '' }} {{ entity.lastName ?? '' }}"
                >
            </div>
            <div class="form-row">
                <label>Issuing Country</label>
                <select name="issuingCountry">
                    <option value="">Select country</option>
                    {% for country in countries %}
                        <option value="{{ country.countryId }}">
                            {{ country.countryName }}
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>
        <div class="button-group">
            <button
                type="button"
                class="cancel-btn"
            >
                Cancel
            </button>
            <button
                type="submit"
                class="save-btn"
            >
                Add Document
            </button>
        </div>
    </form>
</div>

{% endblock %}
