<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %} | Arbor MIS</title>

    {% block stylesheets %}{% endblock %}

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
        }

        nav {
            background-color: #444;
        }

        nav > ul {
            margin: 0;
            padding: 0 20px;
            display: flex;
            list-style: none;
            align-items: center;
        }

        nav > ul > li {
            position: relative;
            color: white;
            padding: 15px 25px;
            cursor: pointer;
            font-size:12px;
        }

        nav > ul > li:hover {
            background-color: #555;
        }

        .menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            min-width: 180px;
            background-color: white;
            padding: 0;
            margin: 0;
            list-style: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .menu li {
            padding: 12px;
            color: black;
            position: relative;
        }

        .menu li:hover {
            background-color: #eee;
        }

        .students:hover .menu,
        .school:hover .menu {
            display: block;
        }

        .submenu {
            display: none;
            position: absolute;
            left: 100%;
            top: 0;
            min-width: 180px;
            background-color: white;
            padding: 0;
            margin: 0;
            list-style: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }

        .menu li:hover .submenu {
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }
        .header{
            display:flex;
        }
        .content{
            flex:1;
            padding-left:15px;
            line-height:30px;
        }
    </style>

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>

<body>

<nav>
    <ul>    
        <li>My Items</li>

        <li class="students">
            Students ▼

            <ul class="menu">
                <li>
                    All Students ▶
                    <ul class="submenu">
                        <li>Browse Students</li>
                        <li>Add New Student</li>
                    </ul>
                </li>

                <li>Behaviour</li>
                <li>Attendance</li>
            </ul>
        </li>

        <li class="school">
            School ▼

            <ul class="menu">
                <li>
                    All Staff ▶
                    <ul class="submenu">
                        <li>Browse Staff</li>
                        <li>Add New Staff</li>
                    </ul>
                </li>
            </ul>
        </li>

        <li>Reporting</li>
        <li>System</li>
    </ul>
</nav>
{%block body%}{%endblock%}
</body>
</html>