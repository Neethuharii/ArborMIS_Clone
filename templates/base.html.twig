<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %} | Arbor MIS</title>
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% endblock %}
    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>
<body>
<nav>
    <ul>   
    <li class="students">
            My Items ▼
            <ul class="menu">
                <li>
                    Enrollments ▶
                    <ul class="submenu">
                        <li>
                            <a href="#">
                                Enroll Student
                        </li>
                        <li>
                            <a href="#">
                                Assign Staff
                            </a>
                        </li>
                    </ul> 
                </li>
            </ul>
        </li> 
        <li class="students">
            Students ▼
            <ul class="menu">
                <li>
                    All Students ▶
                    <ul class="submenu">
                        <li>
                            <a href="{{ path('studentsList') }}">
                                Browse Students
                        </li>
                        <li>
                            <a href="{{ path('newstudent') }}">
                                Add New Student
                            </a>
                        </li>
                    </ul> 
                </li>
                <li>
                    Behaviour ▶
                    <ul class="submenu">
                        <li>Incidents</li>
                        <li>Suspensions</li>
                    </ul>
                </li>
                <li>Attendance</li>
            </ul>
        </li>
        <li class="school">
            School ▼
            <ul class="menu">
                <li>
                    All Staff ▶
                    <ul class="submenu">
                        <li><a href="{{ path('browseStaff') }}">Browse Staff </a></li>
                        <li><a href="{{ path('addstaff') }}">Add New Staff </a></li>
                  </ul>
                </li>
            </ul>
        </li>
        <li>Reporting</li>
        <li>System</li>
    </ul>
</nav>
{% block body %}{% endblock %}
</body>
</html>
