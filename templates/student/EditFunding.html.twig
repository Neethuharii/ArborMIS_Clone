{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/Student/EditFunding.css') }}">
{% endblock %}

{% block body %}

<div class="funding-page">

    <div class="page-title">
        <h2>Edit Student Funding</h2>
    </div>

    <!-- Student Summary -->
    <div class="student-card">

        <div class="student-image">
            {% if student.profileImage %}
                <img src="{{ asset(student.profileImage) }}" alt="Student">
            {% else %}
                <img src="{{ asset('images/default-user.png') }}" alt="Student">
            {% endif %}
        </div>

        <div class="student-details">

            <h3>
                {{ student.firstName }} {{ student.lastName }}
            </h3>
        
        </div>

    </div>

    <!-- Funding Form -->

    <form action="{{ path('edit_funding', {'id': funding.fundingId}) }}" method="post">

        <div class="form-card">

            <div class="form-row">

                <label>
                    Funding type <span>*</span>
                </label>

                <select name="fundingType">

                    {% for type in fundingTypes %}
                        <option
                                value="{{ type.fundingTypeId }}"
                                {% if funding.fundingType.fundingTypeId == type.fundingTypeId %}
                                    selected
                                {% endif %}
                        >
                            {{ type.fundingTypeName }}
                        </option>
                    {% endfor %}

                </select>

            </div>

            <div class="form-row">

                <label>Start date</label>

                <input
                        type="date"
                        name="startDate"
                        value="{{ funding.startDate|date('Y-m-d') }}"
                >

            </div>

            <div class="form-row">

                <label>End date</label>

                <input
                        type="date"
                        name="endDate"
                        value="{% if funding.endDate %}{{ funding.endDate|date('Y-m-d') }}{% endif %}"
                >

            </div>

            <div class="form-row textarea">

                <label>Note</label>

                <textarea name="description">{{ funding.description }}</textarea>

            </div>
        </div>

        <div class="buttons">

            <button class="delete-btn" type="submit" name="delete">
                Delete
            </button>

            <div>

                <a href="{{ path('studentProfile', {'studentId': student.studentId}) }}"
                   class="cancel-btn">
                    Cancel
                </a>

                <button class="save-btn" type="submit">
                    Save Changes
                </button>

            </div>

        </div>

    </form>

</div>

{% endblock %}
