
{% block title %}Edit Identity{% endblock %}

{% block body %}


   <div class="identity-drawer-content">

    <div class="drawer-header">
        <h2>{{ data.field|replace({'_':' '})|title }}</h2>
    </div>
<form
    method="post"
    action="{{ path('student_identity_edit', {
        studentId: student.studentId,
        field: data.field
    }) }}"
    onsubmit="submitEditForm(event)"
>

        {% if data.field == 'dob' %}

            <label>Date of Birth</label>

            <input
                type="date"
                name="value"
                value="{{ data.value }}"
                class="form-control">

        {% elseif data.field == 'country' %}

            <label>Country</label>

            <select name="value" class="form-control">
                {% for country in data.countries %}
                    <option
                        value="{{ country.countryId }}"
                        {% if data.value == country.countryId %}selected{% endif %}>
                        {{ country.countryName }}
                    </option>
                {% endfor %}
            </select>

        {% elseif data.field == 'religion' %}

            <label>Religion</label>

            <select name="value" class="form-control">
                {% for religion in data.religions %}
                    <option
                        value="{{ religion.religionId }}"
                        {% if data.value == religion.religionId %}selected{% endif %}>
                        {{ religion.religionName }}
                    </option>
                {% endfor %}
            </select>

        {% elseif data.field == 'ethnicity' %}

            <label>Ethnicity</label>

            <select name="value" class="form-control">
                {% for ethnicity in data.ethnicities %}
                    <option
                        value="{{ ethnicity.ethnicityId }}"
                        {% if data.value == ethnicity.ethnicityId %}selected{% endif %}>
                        {{ ethnicity.ethnicityName }}
                    </option>
                {% endfor %}
            </select>

       {% elseif data.field == 'nationality' %}

    <select name="value" class="form-control">

        {% for nationality in data.nationalities %}
            <option
                value="{{ nationality.nationalityId }}"
                {% if data.value == nationality.nationalityId %}selected{% endif %}>
                {{ nationality.nationalityStatus }}
            </option>
        {% endfor %}

    </select>



        {% else %}

            <label>{{ data.field|title }}</label>

            <input
                type="text"
                name="value"
                value="{{ data.value }}"
                class="form-control">

        {% endif %}

        <div class="form-actions">

            <button
                type="button"
                class="cancel-btn"
                onclick="closeDrawer()">
                Cancel
            </button>

            <button
                type="submit"
                class="save-btn">
                Save
            </button>

        </div>

    </form>

</div>

<script>
function submitEditForm(e)
{
    e.preventDefault();

    fetch(e.target.action, {
        method: 'POST',
        body: new FormData(e.target)
    })
    .then(() => {
        location.reload();
    });
}
</script>

<style>
.identity-drawer-content {
    padding: 20px;
}

.drawer-header {
    margin-bottom: 20px;
}

.form-control {
    width: 100%;
    padding: 10px;
    margin-top: 8px;
    margin-bottom: 20px;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}

.cancel-btn {
    background: #ddd;
    border: none;
    padding: 10px 18px;
    cursor: pointer;
}

.save-btn {
    background: #28a745;
    color: white;
    border: none;
    padding: 10px 18px;
    cursor: pointer;
}
</style>

{% endblock %}
