{% extends 'base.html.twig' %}

{% block title %}Browse Students{% endblock %}

{% block body %}

<div class="student-layout">

    <div class="student-content">

        <link rel="stylesheet" href="{{ asset('css/Student/StudentLists.css') }}">

        <div id="page-loader" style="display:none;">
            <div class="loader-box">
                <img src="{{ asset('images/arborlogo.png') }}" class="rotating-logo">
                <p>Loading...</p>
            </div>
        </div>

        <div id="list-student-card">

            <div class="browse-container">

                <div class="top-bar">
                    <h1>Browse Students</h1>
                </div>

                <div class="search-box">
                    <form method="get" onsubmit="showLoader()">
                        <input type="text" name="search" value="{{ search }}">
                        <button type="submit">Search</button>
                    </form>
                </div>

                <div class="student-grid">

                    {% for student in studentList %}

                        <a href="{{ path('studentProfile', {'studentId': student.studentId}) }}"
                           class="student-link">

                            <div class="student-card">

                                <div class="avatar">
                                  <img
                  src="{{ student.profileImage 
                  ? asset('uploads/profile/' ~ student.profileImage) 
                  : asset('images/defaultProfile.png') }}"
                  alt="Profile Image"
                  style="cursor:pointer;"
                >
                                </div>

                                <div class="info">

                                    <h2>
                                        {{ student.firstName|title }}
                                        <strong>{{ student.lastName|title }}</strong>
                                    </h2>

                                    <div class="row">
                                        <span>DOB:</span>
                                        <b>{{ student.dob|date('d M Y') }}</b>
                                    </div>

                                    <div class="row">
                                        <span>Email:</span>
                                        <b>{{ student.address.emailAddress }}</b>
                                    </div>

                                    <div class="row">
                                        <span>Phone Number:</span>
                                        <b>{{ student.address.phoneNumber }}</b>
                                    </div>

                                </div>

                            </div>

                        </a>

                    {% else %}

                        <p>No students found</p>

                    {% endfor %}

                </div>

            </div>

        </div>

    </div>

</div>

<script>
function showLoader() {
    document.getElementById("page-loader").style.display = "flex";
}
</script>

{% endblock %}
