{% block body %}

{% set funding_route = 'add_funding' %}

<div class="identification-wrapper">

    <form id="fundingForm"
          class="identification-form"
          action="{{ path(funding_route, {'id': student.studentId}) }}"
          method="POST">

        <input type="hidden" name="studentId" value="{{ student.studentId }}">

        <div class="form-container">
            <div class="form-row">
                <label>Funding Type <span class="required">*</span></label>

                <select name="fundingType" required>
                    <option value="">Select funding type</option>

                    {% for type in fundingTypes %}
                        <option value="{{ type.fundingTypeId }}">
                            {{ type.fundingTypeName }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-row">
                <label>Start Date</label>

                <input type="date" name="startDate">
            </div>

            <div class="form-row">
                <label>End Date</label>

                <input type="date" name="endDate">
            </div>

            <div class="form-row">
                <label>Note</label>

                <textarea name="description"></textarea>
            </div>

        </div>

        <div class="button-group">

            <button type="button"
                    class="btn-cancel"
                    onclick="document.getElementById('closeBtn').click()">
                Cancel
            </button>

            <button type="submit" class="save-btn">
                Add Funding
            </button>

        </div>

    </form>
</div>

{% endblock %}
