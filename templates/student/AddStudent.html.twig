{% extends 'base.html.twig' %}

{% block title %}Add New Student{% endblock %}

{% block body %}
     
    <link rel="stylesheet" href="{{ asset('css/Student/AddStudent.css') }}">
    <div id="page-loader" style="display:none;">
        <div class="loader-box">
            <img src="{{ asset('images/arborlogo.png') }}"  class="rotating-logo">
                <p>Loading...</p>
        </div>
    </div>
    <div id="form-page">

        <div class="page-container" >

        <h1 class="page-title">Create New Student</h1>
        {% for message in app.flashes('success') %}
            <div  class="success-message" >
                {{ message }}
            </div>
        {% endfor %}
            <div class="student-card">

                <div class="section-title">
                    New Student
                </div>

                <form method="post" onsubmit="showLoader()">

                    <div class="form-row">
                        <div class="form-group">
                            <label>
                                First Name <span class="required">*</span>
                            </label>
                            <input
                                type="text"
                                name="firstName"
                                placeholder="Enter first name"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label>Middle Name</label>
                            <input
                                type="text"
                                name="middleName"
                                placeholder="Enter middle name"
                            >
                        </div>

                        <div class="form-group">
                            <label>
                                Last Name <span class="required">*</span>
                            </label>
                            <input
                                type="text"
                                name="lastName"
                                placeholder="Enter last name"
                                required
                            >
                        </div>
                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label>
                                Gender <span class="required">*</span>
                            </label>

                            <select name="gender" required>
                                <option value="">Select Gender</option>
                                    {% for gender in genders %}
                                        <option value="{{ gender.genderId }}">
                                            {{ gender.genderType }}
                                        </option>
                                    {% endfor %}
                            </select>
                           {% if errors.gender is defined %}
                                <span class="error-message">
                                {{ errors.gender }}
                                </span>
                                {% endif %}
                        </div>

                        <div class="form-group">
                            <label>
                                Date of Birth <span class="required">*</span>
                            </label>
                            <input
                                type="date"
                                name="dob"
                                required
                            >
                        </div>

                        <div class="form-group">
                            <label>Email Address</label>
                            <input
                                type="email"
                                name="email"
                                placeholder="Enter email address"
                            >
                            {% if errors.email is defined %}
                                <span class="error-message">
                                    {{ errors.email }}
                                </span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Contact Number</label>
                            <input
                                type="text"
                                name="phoneNumber"
                                placeholder="Enter contact number"
                            >
                            {% if errors.phoneNumber is defined %}
                                <span class="error-message">
                                    {{ errors.phoneNumber }}
                                </span>
                            {% endif %}
                        </div>

                        <div class="form-group">
                        </div>
                    </div>

                    <div class="button-container">
                    
                        <button type="submit" class="btn btn-save">
                            Create Student
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
    <script>
        function showLoader() {
            document.getElementById("form-page").style.filter = "blur(1px)";
            document.getElementById("page-loader").style.display = "flex";
        }
    </script>
{% endblock %}
