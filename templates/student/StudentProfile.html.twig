{% extends 'base.html.twig' %}

{% block title %}Student Profile{% endblock %}

{% block body %}

<link rel="stylesheet" href="{{ asset('css/Student/StudentProfile.css') }}">

<div class="profile-page">

    <h1>Student Profile</h1>

    <div class="profile-card">

        <div class="profile-image">
            <img src="{% if student.profileImage %}
                        {{ asset('uploads/students/' ~ student.profileImage) }}
                      {% else %}
                        {{ asset('images/defaultProfile.png') }}
                      {% endif %}">
        </div>

        <div class="profile-info">

            <h2>
                {{ student.firstName|title }}
                {{ student.lastName|title }}
            </h2>

            <div class="profile-row">
                <span>Date of Birth</span>
                <strong>{{ student.dob|date('d M Y') }}</strong>
            </div>

            <div class="profile-row">
                <span>Email</span>
                <strong>{{ student.address.emailAddress }}</strong>
            </div>

            <div class="profile-row">
                <span>Phone</span>
                <strong>{{ student.address.phoneNumber }}</strong>
            </div>

        </div>

    </div>

    <div class="section">

        <div class="section-header">
            <h2>Identity</h2>
        </div>

        <table class="details-table">

    <tr>
        <th>Name</th>
        <td>{{ student.firstName }} {{ student.lastName }}</td>
        <td>
            <a href="{{ path('student_identity_edit', {
                studentId: student.studentId,
                field: 'name'
            }) }}">▶</a>
        </td>
    </tr>

    <tr>
        <th>Sex</th>
        <td>{{ student.gender.genderType }}</td>
        <td>
            <a href="{{ path('student_identity_edit', {
                studentId: student.studentId,
                field: 'gender'
            }) }}">▶</a>
        </td>
    </tr>

    <tr>
        <th>Date of Birth</th>
        <td>{{ student.dob|date('d M Y') }}</td>
        <td>
            <a href="{{ path('student_identity_edit', {
                studentId: student.studentId,
                field: 'dob'
            }) }}">▶</a>
        </td>
    </tr>

    <tr>
    <th>Country of Birth</th>
    <td>
        {{ student.country ? student.country.countryName : 'Not specified' }}
    </td>
    <td>
        <button class="side-edit-btn"
                onclick="openSidePanel('country', {{ student.studentId }})">
            ▶
        </button>
    </td>
</tr>

    <tr>
        <th>Ethnicity</th>
        <td>{{ student.ethnicity? student.ethnicity.ethnicity_name }}</td>
        <td>
            <a href="{{ path('student_identity_edit', {
                studentId: student.studentId,
                field: 'ethnicity'
            }) }}">▶</a>
        </td>
    </tr>

    <tr>
        <th>Nationality</th>
        <td>{{ student.nationality ? student.nationality.nationality_status }}</td>
        <td>
            <a href="{{ path('student_identity_edit', {
                studentId: student.studentId,
                field: 'nationality'
            }) }}">▶</a>
        </td>
    </tr>

    <tr>
        <th>Religion</th>
        <td>{{ student.religion ?student.religion.religionName }}</td>
        <td>
            <a href="{{ path('student_identity_edit', {
                studentId: student.studentId,
                field: 'religion'
            }) }}">▶</a>
        </td>
    </tr>

    <tr>
        <th>UPN</th>
        <td>{{ student.upn }}</td>
        <td>
            <a href="{{ path('student_identity_edit', {
                studentId: student.studentId,
                field: 'upn'
            }) }}">▶</a>
        </td>
    </tr>

</table>

    </div>

</div>
<div id="sidePanel" class="side-panel">

    <div class="side-panel-header">
        <h3 id="sideTitle">Edit</h3>
        <button onclick="closeSidePanel()">✖</button>
    </div>

    <div id="sideContent">
        Loading...
    </div>

</div>

{% endblock %}
