{% extends 'base.html.twig' %}

{% block title %}Teacher Profile{% endblock %}
{% block stylesheets %}
{{parent()}}
<link rel="stylesheet" href="{{asset('css/student/StudentProfile.css')}}">
<link rel="stylesheet" href="{{asset('css/Slideover/slideover.css')}}">
 
{% endblock %}

{% block body %}
{{ include('_modalbase.html.twig') }}
<div class="profile-container">
    <form method="post" action="{{ path('student_upload_image', {id: student.studentId}) }}" enctype="multipart/form-data">
    <div class="profile-header">
        <div class="profile-image">
            <label for="profileImageInput">
               <img
                  src="{{ student.profileImage 
                  ? asset('uploads/profile/' ~ student.profileImage) 
                  : asset('images/defaultProfile.png') }}"
                  alt="Profile Image"
                  style="cursor:pointer;"
                >
            </label>

            <input
                type="file"
                id="profileImageInput"
                name="profileImage"
                accept="image/*"
                style="display:none;"
                onchange="this.form.submit();"
            >
        </div>

        <div class="profile-info">
            <h1>{{ student.firstName }} {{ student.lastName }}</h1>

            <table class="summary-table">
                <tr>
                    <td class="label">Date of Birth</td>
                    <td><strong>{{ student.dob|date('d F Y') }}</strong></td>
                </tr>
                <tr>
                    <td class="label">Joined</td>
                    <td><strong>{{ student.createdAt|date('d F') }}</strong></td>
                </tr>
            </table>
        </div>
    </div>
</form>

    <div class="section-card">
        <div class="section-header">
            <h2>Identity</h2>
            <div id="identityAdd"  class="section-add" style="cursor: pointer;">
                    <span class="add-icon">+</span> Add
            </div>
        </div>
        <table class="details-table">
            <tbody>
            {#<tr>
                <th>Name</th>
                <td>{{ student.firstName }} {{ student.lastName }}</td>
                <td class="arrow">▶</td>
            </tr>#}
            <tr class="clickable-row" 
                data-title="Name" 
                data-type="identity"
                data-first-name="{{ student.firstName }}"
                data-middle-name="{{ student.middleName }}"
                data-last-name="{{ student.lastName }}">
                <th>Name</th>
                <td>{{ student.firstName }} {{ student.lastName }}</td>
                <td class="arrow">▶</td>
            </tr>
            <tr class="clickable-row" 
                data-title="Gender" 
                data-type="sex"
                data-gender-type="{{ student.gender.genderType }}">
                <th>Gender</th>
                <td>{{ student.gender.genderType }}</td>
                <td class="arrow">▶</td>
            </tr>
            <tr class="clickable-row" 
                data-title="Date of birth" 
                data-type="dob"
                data-dob="{{ student.dob|date('d/m/Y') }}">
                <th>Date of birth</th>
                <td>{{ student.dob|date('d/m/Y') }}</td>
                <td class="arrow">▶</td>
            </tr>
            <tr class="clickable-row" 
                data-title="Country of birth" 
                data-type="country"
                 data-country-name="{{ student.country?.countryName ?? '' }}">
                <th>Country of birth</th>
                <td>{{ student.country ? student.country.countryName : 'Not recorded' }}</td>
                <td class="arrow">▶</td>
            </tr>
             <tr class="clickable-row" 
                data-title="Ethnicity" 
                data-type="ethnicity"
                data-ethnicity-name="{{ student.ethnicity?.ethnicityName ?? '' }}">
                <th>Ethnicity</th>
               <td>{{ student.ethnicity ? student.ethnicity.ethnicityName : 'Not recorded' }}</td>
                <td class="arrow">▶</td>
            </tr>

             <tr class="clickable-row" 
                data-title="Nationality" 
                data-type="nationality"
                data-nationality-status="{{ student.nationality?.nationalityStatus ?? ''}}">
                <th>Nationality</th>
               <td>{{ student.nationality ? student.nationality.nationalityStatus: 'Not recorded' }}</td>
                <td class="arrow">▶</td>
            </tr>

            <tr class="clickable-row" 
                data-title="Religion" 
                data-type="religion"
                data-religion-name="{{ student.religion?.religionName}}">
                <th>Religion</th>
               <td>{{ student.religion ? student.religion.religionName : 'Not recorded' }}</td>
                <td class="arrow">▶</td>
            </tr>
            <tr class="clickable-row" 
                data-title="Document" 
                data-type="documentId"
               data-card="{{ student.document?.documentType?.documentTypeName ?? '' }}">
                <th>Document</th>
                <td>{{ student.document?.documentType?.documentTypeName ?? 'Not recorded' }}</td>
                <td class="arrow">▶</td>
            </tr>
            <tr class="clickable-row" 
                data-title="Student Id" 
                data-type="studentId"
                data-dob="{{ student.studentId}}">
                <th>Arbor Student Id</th>
                <td>{{ student.studentId ?: 'Not recorded' }}</td>
            </tr>
            <tr class="clickable-row" 
                data-title="School Card Id" 
                data-type="cardId"
                data-card="{{ student.card?.cardNumber ?? ''}}">
                <th>School Id Card</th>
                <td>{{ student.card?.cardNumber ?: 'Not recorded' }}</td>
                <td class="arrow">▶</td>
            </tr>
            <tr class="clickable-row"
                data-title="UPN"
                data-type="upn"
                data-upn="{{ student.upn ?? '' }}">
                <th>UPN</th>
                <td>{{ student.upn ?: 'Not Assigned' }}</td>
                <td class="arrow">▶</td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="section-card">
            <div class="section-header">
                <h2>Student Contact Details</h2>
                    <div id="contactAdd" class="section-add" style="cursor: pointer;">
                            <span class="add-icon">+</span> Add
                    </div>
            </div>

            <table class="details-table">
                <tbody>
                    <tr class="clickable-row" 
                            data-title="Email" 
                            data-type="email"
                            data-email="{{ student.address.emailAddress }}">
                            <th>Work Email</th>
                            <td>{{ student.address.emailAddress }}</td>
                            <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row"
                        data-title="Student Home Number"
                        data-type="phoneNumber"
                        data-phone-number= "{{ student.address ? student.address.phoneNumber : 'Not recorded' }}">
                            <th>Student Home Number</th>
                            <td>{{ student.address ? student.address.phoneNumber : 'Not recorded' }}</td>
                            <td class="arrow">▶</td>
                    </tr>

                    <tr class="clickable-row"
                        data-title="Address"
                        data-type="address"
                        data-address1= "{{ student.address ? student.address.address1 : 'Not recorded' }}"
                        data-address2= "{{ student.address ? student.address.address2 : 'Not recorded' }}"
                        data-address3= "{{ student.address ? student.address.address3 : 'Not recorded' }}"
                        data-city= "{{ student.address ? student.address.city : 'Not recorded' }}"
                        data-county= "{{ student.address ? student.address.county : 'Not recorded' }}"
                        data-post-code= "{{ student.address ? student.address.postCode : 'Not recorded' }}">
                        <th>Postal Address</th>
                        <td>{{ student.address ?student.address.address1 : 'Not recorded' }} 
                            {{ student.address ?student.address.address2 : 'Not recorded' }} 
                            {{ student.address ?student.address.address3 : 'Not recorded' }}
                            {{ student.address ?student.address.city : 'Not recorded' }}
                            {{ student.address ?student.address.county : 'Not recorded' }}
                            {{ student.address ?student.address.postCode : 'Not recorded' }}
                        </td>
                        <td class="arrow">▶</td>
                    </tr>
                </tbody>
            </table>
        </div>
  <div class="section-card">
    <div class="section-header">
        <h2>Family, Guardians and Contacts</h2>

        <div id="contactAddGuardian"
        class="open-slideover"
             
             data-type="guardian"
             style="cursor:pointer;">
            <span class="add-icon">+</span> Add
        </div>
    </div>

    <div class="guardian-list">

        {% if guardianRelations is not empty %}

            {% for relation in guardianRelations %}

                <div class="guardian-row clickable-guardian-row {% if relation.primaryRelation %}primary{% endif %}"
                     data-title="Guardian Details"
                     data-type="guardian"
                     data-first-name="{{ relation.guardian.firstName }}"
                     data-last-name="{{ relation.guardian.lastName }}"
                     data-relationship="{{ relation.relationshipType.relationshipTypeName }}"
                     data-email="{{ relation.guardian.address.emailAddress ?? '' }}"
                     data-phone="{{ relation.guardian.address.phoneNumber ?? '' }}">

                    <div class="guardian-left">
                        <div class="guardian-name">
                            {{ relation.guardian.firstName }} {{ relation.guardian.lastName }}
                        </div>
                        
                    </div>

                    <div class="guardian-middle">
                        <div class="guardian-role">
                            {{ relation.relationshipType.relationshipTypeName }}
                        </div>
                        <div class="guardian-role">
                           {{ relation.guardian.address ? relation.guardian.address.emailAddress : 'Not recorded' }}
                        </div>
                        <div class="guardian-role">
                             {{ relation.guardian.address ? relation.guardian.address.phoneNumber : 'Not recorded' }}
                        </div>

                        <div class="guardian-flags">
                            
                            {% if relation.primaryRelation %}
                                <div>Primary guardian</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="guardian-right">
                        ▶
                    </div>

                </div>

            {% endfor %}

        {% else %}
            <div class="guardian-empty">
                No guardians added.
            </div>
        {% endif %}

    </div>
</div>
 <div class="section-card">
        <div class="section-header">
            <h2>Student Funding </h2>
            <div id="funding"
     class="section-add open-slideover"
     data-type="funding"
     style="cursor: pointer;">
    <span class="add-icon">+</span> Add
</div>

        </div>
        <table class="details-table">
         <tbody>
{% for funding in fundings %}
    <tr class="clickable-row" data-type="funding">
        <th>{{ funding.fundingType.fundingTypeName }}</th>
        <td>{{ funding.startDate|date('d/m/Y') }}</td>
        <td class="arrow">▶</td>
    </tr>
{% else %}
    <tr>
        <td colspan="3">No funding found.</td>
    </tr>
{% endfor %}
</tbody>
        </table>
    </div>
    <div id="slideoverContainer" class="slideover-container">
        <div id="slideoverOverlay" class="slideover-overlay"></div>
            <div class="slideover-drawer">
                <div class="slideover-header">
                    <button id="closeBtn">← Back</button>
                    <h3 id="slideTitle">Details</h3>
                    <button id="nextBtn">Edit</button>
                </div>
                <hr>
                <div class="slideover-body">
                    <div id="slideDynamicContent"></div>
                </div>
            </div>
        </div>
    </div>
    <template id="nameEditTemplate">
        <div class="edit-form-wrapper">
            <h2>Name</h2>
            <form id="editIdentityForm">
            <input
                type="hidden"
                name="studentId"
                value="{{ student.studentId }}"
            >
            <div class="form-row">
                <label>Legal first name</label>
                <input
                    type="text"
                    name="firstName"
                    value="{{ student.firstName }}"
                >
            </div>
            <div class="form-row">
                <label>Preferred first name</label>
                <input
                    type="text"
                    name="preferredFirstName"
                    value="{{ student.firstName }}"
                >
            </div>
            <div class="form-row">
                <label>Legal middle names</label>
                <input
                    type="text"
                    name="middleName"
                    value="{{ student.middleName }}"
                >
            </div>
            <div class="form-row">
                <label>Legal last name</label>
                <input
                    type="text"
                    name="lastName"
                    value="{{ student.lastName }}"
                >
            </div>
            <div class="form-row">
                <label>Preferred last name</label>
                <input
                    type="text"
                    name="preferredLastName"
                    value="{{ student.lastName }}"
                >
            </div>
            <div class="button-group">
                <button
                    type="button"
                    class="cancel-btn"
                    id="cancelEdit"
                >
                    Cancel
                </button>
                <button
                    type="submit"
                    class="save-btn"
                >
                    Save Changes
                </button>
            </div>
            </form>
        </div>
    </template>
    <template id="genderEditTemplate">
        <div class="edit-form-wrapper">
        <form id="editGenderForm">
            <input type="hidden"
                   name="studentId"
                   value="{{ student.studentId }}">
            <div class="gender-row">
        <label for="gender">
            Gender <span class="required">*</span>
        </label>
        <select id="gender"
            name="gender"
            class="gender-select">
            <option value="">Select Sex</option>
                {% for gender in genders %}
                    <option value="{{ gender.genderId }}"
                    {% if student.gender and student.gender.genderId == gender.genderId %}
                        selected
                    {% endif %}
                    >
                {{ gender.genderType }}
            </option>
                {% endfor %}
        </select>
        </div>
            <div class="button-group">
                <button type="button"
                        class="cancel-btn"
                        id="cancelEdit">
                    Cancel
                </button>
                <button type="submit"
                        class="save-btn">
                    Save Changes
                </button>
            </div>
            </form>
        </div>
    </template>
    <template id="dobEditTemplate">
        <div class="edit-form-wrapper">
        <h2>Date of Birth</h2>
        <form id="editDobForm">
            <input
                type="hidden"
                name="studentId"
                value="{{ student.studentId }}"
            >
            <div class="form-row">
                <label>DOB</label>
                <input
                    type="Date"
                    name="dob"
                    value="{{ student.dob|date('d m') }}"
                >
            </div>
            <div class="button-group">
                <button
                    type="button"
                    class="cancel-btn"
                    id="cancelEdit"
                >
                    Cancel
                </button>
                <button
                    type="submit"
                    class="save-btn"
                >
                    Save Changes
                </button>
            </div>
        </form>
        </div>
    </template>
    <template id="countryEditTemplate">
        <div class="edit-form-wrapper">
        <form id="editCountryForm">
            <input type="hidden"
                   name="studentId"
                   value="{{ student.studentId }}">
            <div class="country-row">
                <label for="country">
                    Country <span class="required">*</span>
                </label>
                <select id="country"
                    name="country"
                    class="country-select">
                    <option value="">Select Country</option>
                    {% for country in countries %}
                        <option value="{{ country.countryId }}"
                        {% if student.country and student.country.countryId == country.countryId %}
                            selected
                        {% endif %}
                        >
                    {{ country.countryName }}
                    </option>
                    {% endfor %}
                </select>
            </div>
            <div class="button-group">
                <button type="button"
                        class="cancel-btn"
                        id="cancelEdit">
                    Cancel
                </button>
                <button type="submit"
                        class="save-btn">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
    </template>
    <template id="ethnicityEditTemplate">
        <div class="edit-form-wrapper">
        <form id="editEthnicityForm">
            <input type="hidden"
                   name="studentId"
                   value="{{ student.studentId }}">
            <div class="ethnicity-row">
        <label for="ethnicity">
            Ethnicity <span class="required">*</span>
        </label>
        <select id="ethnicity"
            name="ethnicity"
            class="ethnicity-select">
                <option value="">Select Ethnicity</option>
                    {% for ethnicity in ethnicities %}
                    <option value="{{ ethnicity.ethnicityId }}"
                        {% if student.ethnicity and student.ethnicity.ethnicityId == ethnicity.ethnicityId %}
                        selected
                        {% endif %}
                    >
                    {{ ethnicity.ethnicityName }}
                </option>
                {% endfor %}
        </select>
        </div>
            <div class="button-group">
                <button type="button"
                        class="cancel-btn"
                        id="cancelEdit">
                    Cancel
                </button>
                <button type="submit"
                        class="save-btn">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
    </template>
    <template id="nationalityEditTemplate">
        <div class="edit-form-wrapper">
        <form id="editNationalityForm">
            <input type="hidden"
                   name="studentId"
                   value="{{ student.studentId }}">
            <div class="nationality-row">
        <label for="nationality">
            Nationality <span class="required">*</span>
        </label>
        <select id="nationality"
            name="nationality"
            class="nationality-select">
            <option value="">Select Nationality</option>
                {% for nationality in nationalities %}
                <option value="{{ nationality.nationalityId }}"
                    {% if student.nationality and student.nationality.nationalityId == nationality.nationalityId %}
                    selected
                {% endif %}
            >
                {{ nationality.nationalityStatus }}
            </option>
            {% endfor %}
        </select>
        </div>
        <div class="button-group">
            <button type="button"
                class="cancel-btn"
                id="cancelEdit">
                    Cancel
            </button>
            <button type="submit"
                class="save-btn">
                   Save Changes
            </button>
            </div>
        </form>
        </div>
    </template>
    <template id="religionEditTemplate">
        <div class="edit-form-wrapper">
            <form id="editReligionForm">
               <input type="hidden"
                   name="studentId"
                   value="{{ student.studentId }}">
            <div class="religion-row">
            <label for="religion">
                Religion <span class="required">*</span>
            </label>
        <select id="religion"
            name="religion"
            class="religion-select">
            <option value="">Select Religion</option>
                {% for religion in religions %}
                <option value="{{ religion.religionId }}"
                    {% if student.religion and student.religion.religionId == religion.religionId %}
                        selected
                    {% endif %}
                >
                {{ religion.religionName }}
                </option>
               {% endfor %}
         </select>
        </div>
        <div class="button-group">
            <button type="button"
                class="cancel-btn"
                id="cancelEdit">
                Cancel
            </button>
            <button type="submit"
                class="save-btn">
                Save Changes
             </button>
        </div>
        </form>
    </div>
    </template>
    <template id="identificationTemplate">
        {% include 'Slideover/identificationDocument.html.twig' with {
            entityId: student.studentId,
            entityType: 'student'
        } %}
    </template>
    <template id="studentCardTemplate">
        {% include 'Slideover/studentIdCard.html.twig' with {
            entityId: student.studentId,
            entityType: 'student'
        } %}
    </template>

     <template id="studentGuardianTemplate">
    {% include 'Slideover/student-guardian.html.twig' %}
</template>

<template id="assignUpnTemplate">
    {% include 'Slideover/assign-upn.html.twig' with {
        student: student
    } %}
</template>

<template id="upnEditTemplate">
    {% include 'Slideover/delete-upn.html.twig' with {
        student: student
    } %}

</template>

<template id="fundingCardTemplate">
    {% include 'student/AddFunding.html.twig' with {
        student: student
    } %}
</template>

 <template id="postalAddressTemplate">
            {% include 'Slideover/postalAddress.html.twig' %}
        </template>

 <template id="emailEditTemplate">
            <div class="edit-form-wrapper">
                <h2>Email</h2>
                <form id="editEmailForm">
                    
                    <input type="hidden" name="studentId" value="{{ student.studentId }}">

                    <div class="form-row">
                        <label>Email</label>
                        <input type="email" name="email" value="{{ student.address ? student.address.emailAddress : '' }}">
                    </div>

                    <div class="button-group">
                        <button type="button" class="cancel-btn" id="cancelEdit"> Cancel </button>
                        <button type="submit" class="save-btn"> Save Changes </button>
                    </div>
                </form>
            </div>
        </template>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/formHandler.js') }}"></script>
    <script src="{{ asset('js/modal.js') }}"></script>
    <script src="{{ asset('js/slide.js') }}"></script>
{% endblock %}
