{% extends 'base.html.twig' %}

{% block title %}Student Profile{% endblock %}

{% block body %}

<link rel="stylesheet" href="{{ asset('css/Student/StudentProfile.css') }}">

<div class="profile-page">

    <h1>Student Profile</h1>

    <div class="profile-card">

        <div class="profile-image">
            <img src="{% if student.profileImage %}
                        {{ asset('uploads/students/' ~ student.profileImage) }}
                      {% else %}
                        {{ asset('images/defaultProfile.png') }}
                      {% endif %}">
        </div>

        <div class="profile-info">

            <h2>
                {{ student.firstName|title }}
                {{ student.lastName|title }}
            </h2>

            <div class="profile-row">
                <span>Date of Birth</span>
                <strong>{{ student.dob|date('d M Y') }}</strong>
            </div>

            <div class="profile-row">
                <span>Email</span>
                <strong>{{ student.address.emailAddress }}</strong>
            </div>

            <div class="profile-row">
                <span>Phone</span>
                <strong>{{ student.address.phoneNumber }}</strong>
            </div>

        </div>

    </div>

    <div class="section">

        <div class="section-header">
            <h2>Identity</h2>
        </div>

        <table class="details-table">

            <tr>
                <th>Name</th>
                <td>{{ student.firstName }} {{ student.lastName }}</td>
                <td>
                    <button onclick="openSidePanel('name', {{ student.studentId }})">▶</button>
                </td>
            </tr>

            <tr>
                <th>Sex</th>
                <td>{{ student.gender ? student.gender.genderType : 'Not specified' }}</td>
                <td>
                    <button onclick="openSidePanel('gender', {{ student.studentId }})">▶</button>
                </td>
            </tr>

            <tr>
                <th>Date of Birth</th>
                <td>{{ student.dob|date('d M Y') }}</td>
                <td>
                    <button onclick="openSidePanel('dob', {{ student.studentId }})">▶</button>
                </td>
            </tr>

            <tr>
                <th>Country of Birth</th>
                <td>{{ student.country ? student.country.countryName : 'Not specified' }}</td>
                <td>
                    <button onclick="openSidePanel('country', {{ student.studentId }})">▶</button>
                </td>
            </tr>

            <tr>
                <th>Ethnicity</th>
                <td>{{ student.ethnicity ? student.ethnicity.ethnicityName : 'Not specified' }}</td>
                <td>
                    <button onclick="openSidePanel('ethnicity', {{ student.studentId }})">▶</button>
                </td>
            </tr>

            <tr>
                <th>Nationality</th>
                <td>{{ student.nationality ? student.nationality.nationalityName : 'Not specified' }}</td>
                <td>
                    <button onclick="openSidePanel('nationality', {{ student.studentId }})">▶</button>
                </td>
            </tr>

            <tr>
                <th>Religion</th>
                <td>{{ student.religion ? student.religion.religionName : 'Not specified' }}</td>
                <td>
                    <button onclick="openSidePanel('religion', {{ student.studentId }})">▶</button>
                </td>
            </tr>

            <tr>
                <th>UPN</th>
                <td>{{ student.upn ?: 'Not assigned' }}</td>
                <td>
                    <button onclick="openSidePanel('upn', {{ student.studentId }})">▶</button>
                </td>
            </tr>

        </table>

    </div>

</div>

<!-- SIDE PANEL -->
<div id="sidePanel" class="side-panel">

    <div class="side-panel-header">
        <h3>Edit Field</h3>
        <button onclick="closeSidePanel()">✖</button>
    </div>

    <div id="sideContent">
        Loading...
    </div>

</div>

<script>
function openSidePanel(field, studentId)
{
    fetch(`/student/${studentId}/identity/${field}`)
        .then(res => res.text())
        .then(html => {
            document.getElementById('sideContent').innerHTML = html;
            document.getElementById('sidePanel').classList.add('open');
        });
}

function closeSidePanel()
{
    document.getElementById('sidePanel').classList.remove('open');
}
</script>

{% endblock %}
